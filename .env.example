# Machine-local settings. Copy to `.env`, which is never committed.
# Game installs are read-only: kjk never writes into them.

# Star Wars: Knights of the Old Republic
KJK_KOTOR1=
# Star Wars: Knights of the Old Republic II - The Sith Lords
KJK_KOTOR2=
# Star Wars Jedi Knight: Jedi Academy
KJK_JA=
# TSL's subscribed Steam Workshop items (TSLRCM, …): `on` plays them. A
# build from source (and the approved tests) plays the game folder alone
# unless this says `on`; the player's build plays them unless it says `off`.
KJK_WORKSHOP=
