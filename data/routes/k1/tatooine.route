# Tatooine (K1, tat_m17ab the docking bay, tat_m17aa Anchorhead, tat_m17ag
# the Czerka office, tat_m18aa the Dune Sea, tat_m18ab the Sand People's
# territory, tat_m20aa their enclave, tat_m18ac the Eastern Dune Sea): the
# hunting license, HK-47 bought, the Sand People's peace (HK-47 speaking for
# a player in their robes, the chieftain's vaporators), the krayt dragon,
# the Star Map, Calo Nord's ambush, then off to Kashyyyk. Starts from the
# Dantooine route's checkpoint:
#   kjk playthrough k1 @dan_council data/routes/k1/tatooine.route --god
exit dan13_tom12aa       # out of the Enclave, up the Ebon Hawk's ramp
use GalaxyMap            # the galaxy map: Tatooine
travel 4                 # the take-off (stunt_12: Malak hires Calo Nord),
module stunt_00          # the vision (stunt_00),
module ebo_m12aa         # landed: Bastila on the Star Map in a cave
talk
say i'll pay             # the customs officer: the docking fee paid,
say need to get going    # then out of the way (k_ptat_custmove)
exit ebn12_ebonexit      # down the ramp: the docking bay
talk
save tatooine
exit TatooineDoor2@2     # into Anchorhead (the first is the bay's inner door)
exit TatooineTransition@3  # the Czerka office (tat_m17ag)
say about hunting licenses # the hunting license: the Sand People's tribe
say no way to get a license
say i will agree
say go get to it
use tat17_10czerk_01
talk
save tat_license
exit TatooineDoor1       # back into Anchorhead
to tat17_darkjedi01      # Malak's dark Jedi waylay you on the way to the gate:
fight 20                 # fought where they stand, not dragged on to the
                         # gate (they cut its guard down)
use tat17_darkjedi01     # their remains: sabers to sell
use tat17_darkjedi02
use tat17_darkjedi03
exit TatooineTransition@6  # Yuka Laka's droid shop (tat_m17ac): HK-47, who
skill persuade=20        # speaks the Sand People's tongue; the party's gear
say what do you have in stock besides droids?  # (the dark Jedi's sabers too) sold
use tat17_08yuka_01      # to her for his price (talked down to 2500)
talk
equip g_w_lghtsbr01      # the Jedi's own saber in hand: what is carried is for sale
sell 2500
say what do you have available in your shop?
say i'm interested. let's talk price.
say could i convince you to lower the price
say perhaps i can convince you to go lower
say [persuade] come now, think of the advertising
say 2500 credits then
say thanks. goodbye.
use tat17_08yuka_01
talk
party 3,7                # HK-47 and T3-M4: droids need no disguise
use tat17_08hk47_01
talk
save tat_hk
exit TatooineDoor1       # back into Anchorhead
to tat17_11guard_01
use tat17_11guard_01     # the gate's guard: the license
talk
module tat_m18aa         # the Dune Sea
save dune_sea
to AreaTransition        # the Sand People on the dunes by the way on (no
fight 30                 # leaving in a fight)
use g_tuskenmale02       # one's robes: the player's disguise (the droids
equip tat17_sandperdis   # need none) past the territory's turrets
exit AreaTransition      # the Sand People's territory (tat_m18ab)
to tat18_sandspeak       # the enclave's gate and its guards
fight 25
exit TatooineDoor3       # the Sand People's enclave (tat_m20aa): HK-47
save sand_enclave        # talks with its first warrior, then the chieftain:
say quickly, tell him we are not a threat!  # he wants moisture
say apologize for being here. say we want peace.  # vaporators for peace
say tell him we want a peaceful solution.
say ask what it is that he wants.
say tell him we will get his vaporators.
to tat20_guardtrig
talk
talk
save chieftain
exit AreaTransition@1    # escorted out: back through the Dune Sea to
exit AreaTransition@3    # Anchorhead and the Czerka storehouse
exit TatooineTransition@3
say what do you have available for purchase?  # the loot sold to Greeta
say =no, just your normal fare.
use tat17_10greet_01
talk
sell 500                 # (and Kashyyyk's docking fee to come)
say what do you have available for purchase?  # the vaporators, talked
say do you have any moisture vaporators?       # down to 200
say to exchange with sand people
say could you be persuaded to lower the price?
say [persuade] czerka's costs, not yours
say 200 for the moisture vaporators sounds fine
use tat17_10greet_01
talk
save vaporators
exit TatooineDoor1
to tat17_11guard_01      # out of the gate again
use tat17_11guard_01
talk
module tat_m18aa
exit AreaTransition@1
exit TatooineDoor3@1     # the vaporators delivered: peace, his gaffi stick,
say tell him that we have his vaporators.  # the Star Map's way (the
say i have a few questions for him.        # Eastern Dune Sea's map), the
say ask about the star map.                # Jawas freed
say ask about captives.
say tell him farewell for now.
use tat20_09chief_01
talk
save sand_peace
use tat20_ragpile@5      # bantha fodder, by the enclave's banthas
exit TatooineDoor3@6     # out, and on to the Eastern Dune Sea
exit AreaTransition@2    # (the chieftain's map: tat_KraytMap, its acquire hook)
say have your fodder     # Komad's plan: the banthas lured onto his mines
say what i can do
use tat18_11komad_01
talk
save komad
to tat18_bantha1         # the herd smells the fodder and follows; the Sand
use tat18_bantha1        # People howl: their ambush
talk
fight 60                 # (they gather by the herd, out past 30 m)
save banthas
use tat18_bantha1        # no foe left near (k_ptat_banthdlg): the banthas led
talk                     # to the cave, the krayt dragon out onto Komad's mines
use tat18_11komad_01     # Komad: the hunt done
talk
save krayt
use k_tat_star_map       # the Star Map in the dragon's cave
talk
save tat_star_map
to tat_ambush_spawns     # by the Star Map: Calo Nord's ambush set (k_trg_calonord2)
to tat_test              # out at the cave's mouth: Calo and his hunters
talk
fight 30
save calo
