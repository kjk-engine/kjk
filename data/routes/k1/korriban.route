if KOR_YUTHURA2=0              # Yuthura's past, in three talks before
say =tell me about yourself.   # Uthar names the final test (then she only
                               # barks): at the tomb she is talked round
say =i'll be going.
use kor35_yuthura
talk
end
say you mentioned you were from sleheyron
say [persuade] i just would like to know more
say =i'll be going.
use kor35_yuthura
talk
say how did you become a sith?
say i'd really like to hear the tale.
say [persuade] i just thought we could become friends
say =i'll be going.
use kor35_yuthura
talk
save kor_yuthura_past
say i know the code      # Uthar's test of the Code (its true-or-false
say =passion.            # question drawn here is the passion one)
say =strength.
say =power.
say =victory.
say my chains are broken
say i'll be on my way
use kor35_utharwynn
talk
save kor_code
to kor35_torturer        # the interrogator's Mandalorian: the serums
say activate the serum console
say =[inject truth serum: high dosage.]
say activate the serum console
say =[apply anti-serum: small dosage.]
say activate the serum console
say =[inject truth serum: high dosage.]
say tell me where your weapon cache is
use kor35_torturecomp
talk
talk
